# Copia este archivo como .env y completa los valores.
# En Render, cárgalos en Environment (no en el repositorio).

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=tu-anon-key

# Google AI Studio (OCR de facturas)
GOOGLE_API_KEY=tu-google-api-key

# Dominio(s) del frontend separados por coma (CORS). Vacío = cualquier origen (sólo desarrollo).
FRONTEND_URL=https://tu-app.vercel.app

PORT=3000
NODE_ENV=development
